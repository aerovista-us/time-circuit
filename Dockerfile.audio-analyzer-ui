FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY tools/requirements-audio-tools.txt /app/tools/requirements-audio-tools.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install -r /app/tools/requirements-audio-tools.txt

COPY . /app

EXPOSE 8765

ENV AUDIO_UI_HOST=0.0.0.0
ENV AUDIO_UI_PORT=8765
ENV AUDIO_UI_DEBUG=false

CMD ["python", "tools/audio_analysis_web.py"]
